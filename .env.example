# ─── WhatsApp ─────────────────────────────────────────────
# Ton numéro au format international, sans "+" ni espaces (ex : 33612345678).
# Seuls les messages venant de ce numéro sont écoutés par le bot.
OWNER_NUMBER=33612345678

# ─── Fuseau horaire ───────────────────────────────────────
TZ=Europe/Paris

# ─── Planning ─────────────────────────────────────────────
# Lien ICS de ton emploi du temps (Hyperplanning, Google Agenda, Ypareo, Aurion…).
# Laisse vide pour n'utiliser que config/planning.json.
ICS_URL=
# Mots-clés qui identifient un créneau "en autonomie" dans le titre/description (séparés par des virgules).
AUTONOMY_KEYWORDS=autonomie,autonome,travail personnel,distanciel
# Planning manuel (créneaux hebdo + dates ponctuelles).
PLANNING_FILE=config/planning.json

# ─── Rappels ──────────────────────────────────────────────
# Minutes par rapport au début du créneau où le bot te relance (tant que tu n'as pas signé).
# -5 = 5 min avant, 0 = au début, 15 = 15 min après…
REMINDER_OFFSETS=-5,0,15,45
# Fréquence de vérification (secondes)
TICK_SECONDS=30

# ─── SoWeSign / Sowesoft ──────────────────────────────────
SOWESIGN_LOGIN=
SOWESIGN_PASSWORD=
# Sélecteurs CSS et URLs de la plateforme (à ajuster avec `npm run sowesign:inspect`)
SOWESIGN_CONFIG=config/sowesign.json
# true = remplit le code mais ne valide PAS (pour tester sans risque)
SIGN_DRY_RUN=true
# false pour voir le navigateur s'ouvrir (debug en local)
HEADLESS=true

# ─── Navigateur ───────────────────────────────────────────
# Chemin vers Chrome/Chromium (laisser vide = celui de Puppeteer)
CHROME_PATH=
