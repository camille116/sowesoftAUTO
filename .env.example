# ─── Messagerie ───────────────────────────────────────────
# telegram (recommandé : officiel, gratuit, simple) ou whatsapp. Modifiable dans l'appli → Réglages.
CHANNEL=telegram
# Token donné par @BotFather (ou à coller dans l'appli → Réglages → Messagerie)
TELEGRAM_BOT_TOKEN=

# WhatsApp (seulement si CHANNEL=whatsapp) : ton numéro au format international,
# sans "+" ni espaces (ex : 33612345678). Seuls les messages de ce numéro sont écoutés.
OWNER_NUMBER=

# ─── Fuseau horaire ───────────────────────────────────────
TZ=Europe/Paris

# ─── Planning ─────────────────────────────────────────────
# Lien ICS de ton emploi du temps (Hyperplanning, Google Agenda, Ypareo, Aurion…).
# Hyperplanning : Emploi du temps → icône iCal → copier le lien. Il est PERSONNEL : ne le commite jamais.
# Laisse vide pour n'utiliser que config/planning.json.
ICS_URL=
# Mots-clés qui identifient un créneau "en autonomie" dans le titre/description (séparés par des virgules).
# Hyperplanning OMNES : les créneaux ont "Type : AUTONOMIE" ou "Type : ELEARNING". Retire "elearning" si tu ne dois pas signer en e-learning.
AUTONOMY_KEYWORDS=autonomie,autonome,travail personnel,distanciel,elearning,e-learning
# Planning manuel (créneaux hebdo + dates ponctuelles).
PLANNING_FILE=config/planning.json

# ─── Rappels ──────────────────────────────────────────────
# Minutes par rapport au début du créneau où le bot te relance (tant que tu n'as pas signé).
# -5 = 5 min avant, 0 = au début, 15 = 15 min après…
REMINDER_OFFSETS=-5,0,15,45
# Fréquence de vérification (secondes)
TICK_SECONDS=30

# ─── SoWeSoft (app.sowesign.com) ─────────────────────────
# Code établissement (OMNES = 7705, déjà dans config/sowesign.json)
SOWESIGN_INSTITUTION=7705
# Méthode de connexion :
#   password = e-mail + mot de passe SoWeSoft (100 % automatique)
#   code     = identifiant à 8 chiffres + code PIN à 4 chiffres (100 % automatique)
#   sso      = « Identifiants internes » Microsoft : tu te connectes à la main avec `npm run sowesign:login` (session ~25 jours)
SOWESIGN_LOGIN_METHOD=password
SOWESIGN_EMAIL=
SOWESIGN_PASSWORD=
SOWESIGN_ID=
SOWESIGN_PIN=
# true = tape le code SAUF le dernier chiffre (rien n'est envoyé à SoWeSoft) et t'envoie la capture
SIGN_DRY_RUN=true
# false pour voir le navigateur s'ouvrir (debug en local)
HEADLESS=true

# ─── Appli web ────────────────────────────────────────────
# Ouvre http://localhost:3000 (ou l'app LinkeD sur Mac)
WEB_PORT=3000
# Par défaut, l'app n'est accessible QUE depuis cette machine. 0.0.0.0 = ouverte au réseau local
# (déconseillé sur un Wi-Fi partagé, préfère Tailscale). Refusé sans WEB_PASSWORD.
WEB_HOST=
# Mot de passe de l'app (obligatoire si WEB_HOST ouvre l'app au réseau).
WEB_PASSWORD=

# ─── Navigateur ───────────────────────────────────────────
# Chemin vers Chrome/Chromium (laisser vide = celui de Puppeteer)
CHROME_PATH=
